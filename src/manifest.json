{
  "manifest_version": 3,
  "name": "OGee",
  "version": "1.0.0",
  "description": "Inspect Open Graph, Twitter Cards, and meta tags on any page",
  "author": "Byurhan Nurula",
  "homepage_url": "https://github.com/byurhannurula/ogee",
  "permissions": ["storage", "activeTab"],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "34": "icon-34.png",
      "128": "icon-128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "commands": {
    "toggle-panel": {
      "suggested_key": {
        "default": "Ctrl+E",
        "mac": "MacCtrl+E"
      },
      "description": "Open or close the OGee panel"
    },
    "toggle-host-enabled": {
      "suggested_key": {
        "default": "Ctrl+Shift+E",
        "mac": "MacCtrl+Shift+E"
      },
      "description": "Enable or disable OGee on the current site"
    }
  },
  "icons": {
    "34": "icon-34.png",
    "128": "icon-128.png"
  }
}
