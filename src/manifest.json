{
  "manifest_version": 3,
  "name": "TagPeek",
  "version": "1.0.0",
  "description": "Preview OG and Twitter metadata on any page",
  "permissions": ["storage", "activeTab"],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "34": "icon-34.png",
      "128": "icon-128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "commands": {
    "toggle-panel": {
      "suggested_key": {
        "default": "Ctrl+M",
        "mac": "MacCtrl+M"
      },
      "description": "Open or close the TagPeek panel"
    },
    "toggle-host-enabled": {
      "suggested_key": {
        "default": "Ctrl+Shift+M",
        "mac": "MacCtrl+Shift+M"
      },
      "description": "Enable or disable TagPeek on the current site"
    }
  },
  "icons": {
    "34": "icon-34.png",
    "128": "icon-128.png"
  }
}
