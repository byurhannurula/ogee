{
  "version": "1.0.0",
  "name": "ogee",
  "displayName": "OGee",
  "description": "Inspect Open Graph, Twitter Cards, and meta tags on any page",
  "scripts": {
    "dev": "node scripts/build.mjs --watch --target=chromium",
    "dev:firefox": "node scripts/build.mjs --watch --target=firefox",
    "build": "node scripts/build.mjs --target=chromium",
    "build:firefox": "node scripts/build.mjs --target=firefox",
    "build:all": "npm run build && npm run build:firefox",
    "release": "node scripts/release.mjs",
    "store-assets": "node scripts/convert-store-assets.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,html,css,yml,yaml}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "preact": "^10.29.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@testing-library/react": "^16.3.2",
    "@types/chrome": "^0.0.246",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "esbuild": "^0.19.0",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.6.0",
    "happy-dom": "^20.9.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.3",
    "sharp": "^0.34.5",
    "typescript": "^5.2.0",
    "typescript-eslint": "^8.59.1",
    "vitest": "^4.1.5"
  }
}
